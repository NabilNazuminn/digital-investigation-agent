{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/investigate",
      "destination": "/app/main.py"
    },
    {
      "source": "/investigations",
      "destination": "/app/main.py"
    },
    {
      "source": "/investigations/:path*",
      "destination": "/app/main.py"
    },
    {
      "source": "/health",
      "destination": "/app/main.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/app/main.py"
    }
  ]
}